<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE struts PUBLIC
        "-//Apache Software Foundation//DTD Struts Configuration 2.3//EN"
        "http://struts.apache.org/dtds/struts-2.3.dtd">
<struts>
    <package name="ancient04" namespace="/" extends="struts1-default">
        <action name="legacy" class="org.apache.struts2.s1.Struts1Action">
            <param name="className">com.example.learn.struts2.ancient04.Struts1LegacyAction</param>
            <interceptor-ref name="scopedModelDriven">
                <param name="className">com.example.learn.struts2.ancient04.LegacyForm</param>
                <param name="name">legacyForm</param>
                <param name="scope">request</param>
            </interceptor-ref>
            <interceptor-ref name="struts1Stack"/>
            <result name="success">/struts1-result.jsp</result>
        </action>
    </package>
</struts>
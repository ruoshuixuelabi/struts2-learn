<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE struts PUBLIC
        "-//Apache Software Foundation//DTD Struts Configuration 2.3//EN"
        "http://struts.apache.org/dtds/struts-2.3.dtd">
<struts>
    <package name="ancient03" namespace="/" extends="struts-default">
        <action name="actionA" class="com.example.learn.struts2.ancient03.ActionA">
            <result>/a.jsp</result>
        </action>
        <action name="actionB" class="com.example.learn.struts2.ancient03.ActionB">
            <result type="chain">actionA</result>
        </action>
        <action name="actionC" class="com.example.learn.struts2.ancient03.ActionC">
            <result type="chain">actionB</result>
        </action>
    </package>
</struts>
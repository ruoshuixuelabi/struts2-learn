<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE struts PUBLIC
        "-//Apache Software Foundation//DTD Struts Configuration 2.3//EN"
        "http://struts.apache.org/dtds/struts-2.3.dtd">
<struts>
    <!-- CodeBehind 插件启用常量（存在即启用） -->
    <!-- 不存在 struts.codebehind 这个常量，插件靠 classpath 里的 jar 自动激活 -->
    <constant name="struts.codebehind" value="true" />
    <package name="ancient01" namespace="/" extends="struts-default">
        <action name="hello" class="com.example.learn.struts2.ancient01.HelloAction">
            <result name="success">/hello.jsp</result>
        </action>
        <!-- CodeBehind 会自动为 IndexAction 生成默认 URL -->
    </package>
</struts>
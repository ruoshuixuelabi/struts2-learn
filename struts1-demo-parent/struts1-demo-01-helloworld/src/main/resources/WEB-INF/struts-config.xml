<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE struts-config PUBLIC
        "-//Apache Software Foundation//DTD Struts Configuration 1.3//EN"
        "http://struts.apache.org/dtds/struts-config_1_3.dtd">

<struts-config>
    <form-beans>
        <form-bean name="helloForm" type="com.example.learn.struts1.demo01.HelloForm"/>
    </form-beans>

    <action-mappings>
        <action path="/hello"
                type="com.example.learn.struts1.demo01.HelloAction"
                name="helloForm"
                scope="request"
                input="/hello.jsp">
            <forward name="success" path="/success.jsp"/>
        </action>
    </action-mappings>
</struts-config>

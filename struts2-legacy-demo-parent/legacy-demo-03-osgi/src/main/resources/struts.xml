<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE struts PUBLIC
        "-//Apache Software Foundation//DTD Struts Configuration 2.5//EN"
        "http://struts.apache.org/dtds/struts-2.5.dtd">
<struts>
    <!--
        OSGi 配置示例：让 Struts 在 OSGi 容器内运行。
        constant "struts.osgi" 启用 OSGi ObjectFactory，
        让 Action 由 Felix/Equinox 服务注册中心创建。
    -->
    <constant name="struts.osgi" value="true"/>
    <constant name="struts.osgi.host" value="felix"/>
    <constant name="struts.osgi.enableBundleClassLoader" value="true"/>

    <package name="legacy03-osgi" namespace="/" extends="struts-default">
        <action name="hello" class="com.example.learn.struts2.legacy03.HelloAction">
            <result name="success">/hello.jsp</result>
        </action>
    </package>
</struts>
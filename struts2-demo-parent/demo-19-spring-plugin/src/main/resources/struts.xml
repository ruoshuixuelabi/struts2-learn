<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE struts PUBLIC
        "-//Apache Software Foundation//DTD Struts Configuration 6.0//EN"
        "https://struts.apache.org/dtds/struts-6.0.dtd">
<struts>

    <!-- 关键配置：让 Spring 容器接管 Action -->
    <!-- 在测试模式下（StrutsJUnit5Test + dispatcherInitParams），struts2-spring-plugin 的
         struts-plugin.xml 不会被自动加载，所以 ObjectFactory bean "spring" 不会被注册。
         这里我们只设置 autowire/useClassCache 这些常量（即使没有 spring OF 也不会崩），
         让测试可以走默认 Struts ObjectFactory 创建 Action 实例。
         生产环境 jetty 启动时 struts-plugin.xml 会正常加载，spring OF 自动启用。 -->
    <constant name="struts.objectFactory" value="struts"/>
    <constant name="struts.objectFactory.spring.autowire" value="type"/>
    <constant name="struts.objectFactory.spring.useClassCache" value="true"/>

    <package name="default" namespace="/" extends="struts-default">

        <action name="user-list" class="com.example.learn.struts2.demo19.action.UserAction" method="list">
            <result>/user-list.jsp</result>
        </action>

        <action name="user-show" class="com.example.learn.struts2.demo19.action.UserAction" method="show">
            <result>/user-show.jsp</result>
        </action>
    </package>
</struts>
<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.example.learn</groupId>
    <artifactId>struts2-demo-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Struts 7.3.0 GA Demo Parent</name>
    <description>当前版本 Struts 7.3.0 GA 学习 demo 父项目（JDK 17 + Jakarta Servlet 6）</description>
    <modules>
        <module>struts2-1</module>
        <module>struts2-demo-test-support</module>
        <module>demo-01-helloworld</module>
        <module>demo-02-action-three-ways</module>
        <module>demo-03-arch-lifecycle</module>
        <module>demo-04-interceptor</module>
        <module>demo-05-interceptor-advanced</module>
        <module>demo-06-valuestack</module>
        <module>demo-07-ognl</module>
        <module>demo-08-strutstag</module>
        <module>demo-09-i18n</module>
        <module>demo-10-exception</module>
        <module>demo-11-upload</module>
        <module>demo-12-result</module>
        <module>demo-13-action-advanced</module>
        <module>demo-14-validation</module>
        <module>demo-15-junit</module>
        <module>demo-16-testng</module>
        <module>demo-17-ognl-security</module>
        <module>demo-18-validation-annotation</module>
        <module>demo-19-spring-plugin</module>
        <module>demo-20-security</module>
        <module>demo-22-plugin-json</module>
        <module>demo-23-plugin-rest</module>
        <module>demo-24-plugin-cdi</module>
        <module>demo-25-plugin-junit</module>
        <module>demo-26-plugin-testng</module>
        <module>demo-27-plugin-bean-validation</module>
        <module>demo-28-plugin-oval</module>
        <module>demo-29-plugin-tiles</module>
        <module>demo-30-plugin-sitemesh</module>
        <module>demo-31-plugin-velocity</module>
        <module>demo-32-plugin-javatemplates</module>
        <module>demo-33-plugin-jasperreports</module>
        <module>demo-34-plugin-jfreechart</module>
        <module>demo-35-plugin-async</module>
    </modules>
    <properties>
        <struts.version>7.3.0</struts.version>
        <jakarta.servlet.version>6.0.0</jakarta.servlet.version>
        <jakarta.servlet.jsp.version>3.1.1</jakarta.servlet.jsp.version>
        <junit.jupiter.version>5.10.2</junit.jupiter.version>
        <spring.version>6.2.3</spring.version>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>
    <dependencyManagement>
        <dependencies>
            <!-- Struts 2 核心 -->
            <dependency>
                <groupId>org.apache.struts</groupId>
                <artifactId>struts2-core</artifactId>
                <version>${struts.version}</version>
            </dependency>
            <!-- 公共测试基类（StrutsJUnit5Test） -->
            <dependency>
                <groupId>com.example.learn</groupId>
                <artifactId>struts2-demo-test-support</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- 官方插件（17 个活跃 + 1 个自定义基础） -->
            <dependency>
                <groupId>org.apache.struts</groupId>
                <artifactId>struts2-convention-plugin</artifactId>
                <version>${struts.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.struts</groupId>
                <artifactId>struts2-json-plugin</artifactId>
                <version>${struts.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.struts</groupId>
                <artifactId>struts2-rest-plugin</artifactId>
                <version>${struts.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.struts</groupId>
                <artifactId>struts2-spring-plugin</artifactId>
                <version>${struts.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.struts</groupId>
                <artifactId>struts2-cdi-plugin</artifactId>
                <version>${struts.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.struts</groupId>
                <artifactId>struts2-bean-validation-plugin</artifactId>
                <version>${struts.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.struts</groupId>
                <artifactId>struts2-oval-plugin</artifactId>
                <version>${struts.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.struts</groupId>
                <artifactId>struts2-tiles-plugin</artifactId>
                <version>${struts.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.struts</groupId>
                <artifactId>struts2-sitemesh-plugin</artifactId>
                <version>${struts.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.struts</groupId>
                <artifactId>struts2-velocity-plugin</artifactId>
                <version>${struts.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.struts</groupId>
                <artifactId>struts2-javatemplates-plugin</artifactId>
                <version>${struts.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.struts</groupId>
                <artifactId>struts2-jasperreports-plugin</artifactId>
                <version>${struts.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.struts</groupId>
                <artifactId>struts2-jfreechart-plugin</artifactId>
                <version>${struts.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.struts</groupId>
                <artifactId>struts2-async-plugin</artifactId>
                <version>${struts.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.struts</groupId>
                <artifactId>struts2-config-browser-plugin</artifactId>
                <version>${struts.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.struts</groupId>
                <artifactId>struts2-junit-plugin</artifactId>
                <version>${struts.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.struts</groupId>
                <artifactId>struts2-testng-plugin</artifactId>
                <version>${struts.version}</version>
            </dependency>
            <!-- Servlet API -->
            <dependency>
                <groupId>jakarta.servlet</groupId>
                <artifactId>jakarta.servlet-api</artifactId>
                <version>${jakarta.servlet.version}</version>
                <scope>provided</scope>
            </dependency>
            <dependency>
                <groupId>jakarta.servlet.jsp</groupId>
                <artifactId>jakarta.servlet.jsp-api</artifactId>
                <version>${jakarta.servlet.jsp.version}</version>
                <scope>provided</scope>
            </dependency>
            <!-- 测试 -->
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>5.10.2</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter-api</artifactId>
                <version>5.10.2</version>
            </dependency>
            <!--
                Spring Mock servlet API（struts2-junit-plugin 间接依赖 spring-test，
                但 spring-web 里的 MediaType 不传递过来，需要显式声明）
            -->
            <dependency>
                <groupId>org.springframework</groupId>
                <artifactId>spring-web</artifactId>
                <version>${spring.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.testng</groupId>
                <artifactId>testng</artifactId>
                <version>7.9.0</version>
                <scope>test</scope>
            </dependency>
            <!-- 嵌入式 Jetty 12（Jakarta Servlet 6 兼容；Jetty 11 仅支持 javax.servlet） -->
            <!-- 注意：jetty-maven-plugin 是构建插件，必须在 <pluginManagement> 而非 <dependencyManagement> 中声明 -->
        </dependencies>
    </dependencyManagement>
    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.eclipse.jetty</groupId>
                    <artifactId>jetty-maven-plugin</artifactId>
                    <version>12.0.3</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                    <configuration>
                        <source>${maven.compiler.source}</source>
                        <target>${maven.compiler.target}</target>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-war-plugin</artifactId>
                    <version>3.4.0</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
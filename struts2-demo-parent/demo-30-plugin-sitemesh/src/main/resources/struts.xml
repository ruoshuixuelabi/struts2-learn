<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE struts PUBLIC
        "-//Apache Software Foundation//DTD Struts Configuration 6.0//EN"
        "https://struts.apache.org/dtds/struts-6.0.dtd">

<struts>
    <package name="sitemesh-demo" namespace="/" extends="struts-default">
        <action name="home" class="com.example.learn.struts2.demo30.HomeAction">
            <result>/home-page.jsp</result>
        </action>

        <action name="user-list" class="com.example.learn.struts2.demo30.UserListAction" method="list">
            <result>/user-list.jsp</result>
        </action>
    </package>

    <!-- /api/raw.action：拆出独立 namespace 用普通 action 名 "raw" -->
    <package name="api" namespace="/api" extends="struts-default">
        <action name="raw" class="com.example.learn.struts2.demo30.RawApiAction" method="raw">
            <result>/raw.jsp</result>
        </action>
    </package>
</struts>
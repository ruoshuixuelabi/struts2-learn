<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              name="dynamic" pageWidth="595" pageHeight="200">
    <field name="id"       class="java.lang.Long"/>
    <field name="username" class="java.lang.String"/>
    <detail>
        <band height="40">
            <staticText><reportElement x="0" y="0" width="60" height="20"/>
                <text><![CDATA[运行时：]]></text></staticText>
            <textField><reportElement x="60" y="0" width="120" height="20"/>
                <textFieldExpression><![CDATA[$F{username}]]></textFieldExpression></textField>
        </band>
    </detail>
</jasperReport>
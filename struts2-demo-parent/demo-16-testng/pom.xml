<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.example.learn</groupId>
        <artifactId>struts2-demo-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>demo-16-testng</artifactId>
    <packaging>war</packaging>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.apache.struts</groupId>
            <artifactId>struts2-core</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.servlet.jsp</groupId>
            <artifactId>jakarta.servlet.jsp-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.testng</groupId>
            <artifactId>testng</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.struts</groupId>
            <artifactId>struts2-testng-plugin</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            TestNG 用例虽然用 struts2-testng-plugin 的 TestNGStrutsTestCase，但本 demo 仍
            继承 StrutsTestCase（junit-plugin 提供）以复用 request/executeAction/actionInvocation 字段。
        -->
        <dependency>
            <groupId>org.apache.struts</groupId>
            <artifactId>struts2-junit-plugin</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            StrutsJUnit4TestCase 用 spring-test 的 MockHttpServletResponse，
            该类静态初始化依赖 org.springframework.http.MediaType（即 spring-web）。
            spring-test 自身不传递依赖 spring-web，需显式补上。
        -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
            <version>6.2.19</version>
            <scope>test</scope>
        </dependency>
        <!--
            公共测试基类 org.apache.struts2.StrutsJUnit5Test，封装 JUnit 5 生命周期 +
            query-string 剥离 + 参数注入 + struts-plugin.xml 加载。
        -->
        <dependency>
            <groupId>com.example.learn</groupId>
            <artifactId>struts2-demo-test-support</artifactId>
            <version>1.0.0-SNAPSHOT</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>demo-16-testng</finalName>
        <plugins>
            <plugin>
                <groupId>org.eclipse.jetty</groupId>
                <artifactId>jetty-maven-plugin</artifactId>
                <configuration>
                    <webApp>
                        <contextPath>/demo-16-testng</contextPath>
                    </webApp>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <suiteXmlFiles>
                        <!-- Surefire 3.x 在 forked 进程里用 module dir 作为 basedir 解析相对路径；
                             testng.xml 实际在 src/test/resources/，复制到 target/test-classes/
                             后被 surefire 3 的 StreamTool 用 relative path 解析，因此用绝对 basedir 引用。 -->
                        <suiteXmlFile>src/test/resources/testng.xml</suiteXmlFile>
                    </suiteXmlFiles>
                </configuration>
                <dependencies>
                    <!-- Surefire 3.x TestNG 支持是独立 artifact（surefire-testng，不是 testng-provider）。 -->
                    <dependency>
                        <groupId>org.apache.maven.surefire</groupId>
                        <artifactId>surefire-testng</artifactId>
                        <version>3.2.5</version>
                    </dependency>
                </dependencies>
            </plugin>
        </plugins>
    </build>
</project>
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE struts PUBLIC
        "-//Apache Software Foundation//DTD Struts Configuration 6.0//EN"
        "https://struts.apache.org/dtds/struts-6.0.dtd">
<struts>
    <package name="default" namespace="/" extends="struts-default">
        <interceptors>
            <interceptor name="lifecycleLogger" class="com.example.learn.struts2.demo03.LifecycleLoggerInterceptor"/>
            <interceptor name="lifecycleTimer" class="com.example.learn.struts2.demo03.LifecycleTimerInterceptor"/>

            <interceptor-stack name="lifecycleStack">
                <interceptor-ref name="lifecycleLogger"/>
                <interceptor-ref name="lifecycleTimer"/>
                <interceptor-ref name="defaultStack"/>
            </interceptor-stack>
        </interceptors>

        <action name="lifecycle" class="com.example.learn.struts2.demo03.LifecycleAction">
            <interceptor-ref name="lifecycleStack"/>
            <result>/lifecycle.jsp</result>
        </action>
    </package>
</struts>

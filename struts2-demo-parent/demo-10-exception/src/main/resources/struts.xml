<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE struts PUBLIC
        "-//Apache Software Foundation//DTD Struts Configuration 6.0//EN"
        "https://struts.apache.org/dtds/struts-6.0.dtd">
<struts>
    <!-- Struts 2.5+ 默认禁用 DynamicMethodInvocation（URL 中的 "!" 分隔 method），
         这里 demo-10 依赖 user!delete.action 形式调用 method，需要显式启用。 -->
    <constant name="struts.enable.DynamicMethodInvocation" value="true"/>

    <package name="default" namespace="/" extends="struts-default">

        <!-- 全局 result（必须在 global-exception-mappings 之前；Struts DTD 顺序约束） -->
        <global-results>
            <result name="error">/error.jsp</result>
            <result name="user-notfound">/user-notfound.jsp</result>
        </global-results>

        <!-- 全局异常映射（兜底） -->
        <global-exception-mappings>
            <!-- 1) 兜底：所有 Throwable -->
            <exception-mapping exception="java.lang.Throwable" result="error"/>
            <!-- 2) 业务异常专用：自定义 UserNotFoundException -->
            <exception-mapping exception="com.example.learn.struts2.demo10.UserNotFoundException"
                               result="user-notfound"/>
        </global-exception-mappings>

        <!-- 导航页 -->
        <action name="home">
            <result>/home.jsp</result>
        </action>

        <!-- 业务 Action -->
        <action name="user" class="com.example.learn.struts2.demo10.UserAction">
            <!-- Action 级异常映射（优先于全局） -->
            <exception-mapping exception="java.lang.IllegalArgumentException" result="input"/>
            <exception-mapping exception="java.lang.SecurityException" result="login"/>
            <result name="success">/home.jsp</result>
            <result name="input">/home.jsp</result>
            <result name="login">/login.jsp</result>
            <!-- 必须放最后：DTD 规定它是 action 的收尾元素 -->
            <allowed-methods>delete, login, throwNpe, findUser</allowed-methods>
        </action>
    </package>
</struts>
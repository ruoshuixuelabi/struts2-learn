<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE tiles-definitions PUBLIC
        "-//Apache Software Foundation//DTD Tiles Configuration 3.0//EN"
        "http://tiles.apache.org/dtds/tiles-config_3_0.dtd">

<tiles-definitions>
    <!-- 基础模板 -->
    <definition name="baseLayout" template="/WEB-INF/layouts/layout.jsp">
        <put-attribute name="title" value="Tiles Demo"/>
        <put-attribute name="header" value="/WEB-INF/layouts/header.jsp"/>
        <put-attribute name="menu" value="/WEB-INF/layouts/menu.jsp"/>
        <put-attribute name="body" value=""/>
        <put-attribute name="footer" value="/WEB-INF/layouts/footer.jsp"/>
    </definition>

    <!-- 首页（继承 baseLayout，仅替换 body） -->
    <definition name="home.tiles" extends="baseLayout">
        <put-attribute name="title" value="首页"/>
        <put-attribute name="body" value="/WEB-INF/home/home.jsp"/>
    </definition>

    <!-- 用户列表页（继承 baseLayout，替换 menu + body） -->
    <definition name="user.list.tiles" extends="baseLayout">
        <put-attribute name="title" value="用户列表"/>
        <put-attribute name="menu" value="/WEB-INF/layouts/user-menu.jsp"/>
        <put-attribute name="body" value="/WEB-INF/user/list.jsp"/>
    </definition>
</tiles-definitions>
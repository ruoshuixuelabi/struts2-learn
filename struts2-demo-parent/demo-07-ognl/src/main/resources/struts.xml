<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE struts PUBLIC
        "-//Apache Software Foundation//DTD Struts Configuration 6.0//EN"
        "https://struts.apache.org/dtds/struts-6.0.dtd">
<struts>
    <!-- OGNL 安全约束（7.x 推荐显式声明） -->
    <constant name="struts.ognl.expressionMaxLength" value="150"/>
    <!-- 静态方法默认禁用；本 demo 显式启用以演示 @java.lang.Math@PI -->
    <constant name="struts.ognl.allowStaticMethodAccess" value="true"/>
    <constant name="struts.ognl.excludedClasses"
              value="java.lang.Runtime,java.lang.Process,java.io.File,java.net.URL"/>
    <constant name="struts.ognl.excludedPackageNames"
              value="java.lang,java.io,java.net,java.util.concurrent"/>

    <package name="default" namespace="/" extends="struts-default">
        <action name="ognl" class="com.example.learn.struts2.demo07.OgnlAction">
            <result>/ognl.jsp</result>
        </action>
    </package>
</struts>
